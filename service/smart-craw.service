[Unit]
Description=smart craw docker service

[Service]
Type=oneshot
RemainAfterExit=yes
# see install.sh
WorkingDirectory=%h/smart-craw/docker
ExecStart=/usr/bin/docker compose -f docker-compose.yml up --detach
ExecStop=/usr/bin/docker compose -f docker-compose.yml stop

[Install]
WantedBy=default.target
