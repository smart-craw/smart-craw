# Rendered at container start by the nginx image's envsubst step
# (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/*). Only variables defined in the
# environment are substituted, so nginx's own $host, $http_upgrade etc. are left alone.
# If your image already templates AGENT_SERVICE / ALLOWED_IP_ADDRESS, reuse that mechanism.

server {
    # The ONLY thing that differs between modes lives in these two small snippets.
    include /etc/nginx/snippets/listen-${UI_TLS}.conf;

    server_name _;

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }

    location /ws/ {
        proxy_pass ${AGENT_SERVICE};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}
